# Featherless Proxy Configuration

# Featherless API
FEATHERLESS_API_BASE=https://api.featherless.ai/v1
FEATHERLESS_API_KEY=your-featherless-api-key-here

# Total concurrent connections available on your plan
MAX_CONCURRENT_CONNECTIONS=16

# Cache TTL in seconds
CACHE_TTL=60

# Queue promotion: a waiting request is raised by one priority level for each
# full window of this length it spends in the queue (default 120 seconds).
PROMOTE_AFTER_SECONDS=120

# Server
HOST=0.0.0.0
PORT=8080

# Database
DATABASE_PATH=proxy.db
# Dreamnet
# Password for the "admin" account you sign in with. Set this BEFORE the first
# start: it is only used when the database is created.
ADMIN_PASSWORD=change-me
# Model used for chats and writing unless a novel picks another one.
DREAMNET_DEFAULT_MODEL=Sao10K/L3-8B-Stheno-v3.2

# Lifelike portraits (optional) - a ComfyUI server with Z-Image-Turbo.
# AI Playground: open its ComfyUI and copy the address (port 49000-49999).
# COMFYUI_URL=http://127.0.0.1:8188
# Model names exactly as ComfyUI lists them. These defaults match a plain
# ComfyUI install; for AI Playground use the names shown in the README.
# ZIMAGE_UNET=z_image_turbo_bf16.safetensors
# ZIMAGE_CLIP=qwen_3_4b.safetensors
# ZIMAGE_VAE=ae.safetensors
# Where generated portraits are saved.
# PORTRAIT_DIR=portraits

# Read-aloud voices (edge-tts, needs internet). Where generated audio is cached.
TTS_CACHE=tts_cache
